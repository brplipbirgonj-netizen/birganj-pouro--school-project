rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- হেল্পার ফাংশনসমূহ ---
    
    function isAuthed() {
      return request.auth != null;
    }

    // ইউজারের ডাটা সংগ্রহের নিরাপদ পদ্ধতি
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // এডমিন রোল চেক করা
    function isAdmin() {
      return isAuthed() && getUserData().role == 'admin';
    }

    // নির্দিষ্ট পারমিশন আছে কিনা চেক করা (এডমিনদের সব পারমিশন ডিফল্টভাবে থাকে)
    function hasPermission(permission) {
      return isAuthed() && (
        getUserData().role == 'admin' || 
        (permission in getUserData().get('permissions', []))
      );
    }

    // --- কালেকশন ভিত্তিক রুলস ---

    // ১. অনলাইন ভর্তি আবেদন (এটি পাবলিক হতে হবে যাতে যে কেউ আবেদন করতে পারে)
    match /admissionApplications/{id} {
      // যে কেউ নতুন আবেদন জমা দিতে পারবে
      allow create: if true;
      // আবেদন পড়া বা ম্যানেজ করার ক্ষমতা শুধুমাত্র অনুমোদিত স্টাফদের থাকবে
      allow read, write: if isAuthed() && hasPermission('manage:admissions');
    }

    // ২. স্কুল তথ্য
    match /school/info {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ৩. ইউজার প্রোফাইল
    match /users/{userId} {
      allow get: if isAuthed() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isAuthed() && request.auth.uid == userId;
      
      // ইউজার যাতে নিজের রোল নিজে বাড়াতে না পারে তার নিরাপত্তা
      allow update: if isAdmin() || (
        isAuthed() && request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'permissions'])
      );
      allow delete: if isAdmin();
    }

    // ৪. একাডেমিক ও ম্যানেজমেন্ট কালেকশন
    match /classRoutines/{id} {
      allow read: if isAuthed();
      allow write: if hasPermission('manage:routines');
    }

    match /proxyClasses/{id} {
      allow read: if isAuthed();
      allow write: if hasPermission('manage:routines');
    }

    match /notices/{id} {
      allow read: if isAuthed();
      allow write: if hasPermission('manage:documents');
      allow delete: if isAdmin();
    }

    match /holidays/{id} {
      allow read: if isAuthed();
      allow write: if hasPermission('manage:documents');
      allow delete: if isAdmin();
    }
    
    match /exams/{id} {
      allow read: if isAuthed();
      allow write: if isAdmin();
    }

    match /students/{id} {
      allow read: if isAuthed();
      allow write: if hasPermission('manage:students');
      allow delete: if isAdmin();
    }
    
    match /staff/{id} {
      allow read: if isAuthed();
      allow write: if hasPermission('manage:staff');
      allow delete: if isAdmin();
    }

    match /staffAttendance/{id} {
      allow read: if isAuthed();
      allow write: if hasPermission('manage:staff-attendance');
    }

    match /attendance/{id} {
      allow read: if isAuthed();
      allow write: if hasPermission('manage:attendance');
      allow delete: if isAdmin();
    }
    
    match /results/{id} {
      allow read: if isAuthed();
      allow write: if hasPermission('input:results') || hasPermission('manage:results');
      allow delete: if isAdmin();
    }

    match /messageLogs/{id} {
      allow read: if isAuthed();
      allow create: if hasPermission('send:messaging');
      allow update, delete: if hasPermission('manage:messaging');
    }

    match /feeCollections/{id} {
      allow read: if isAuthed();
      allow write: if hasPermission('collect:fees');
      allow delete: if isAdmin();
    }

    match /transactions/{id} {
      allow read: if isAuthed();
      allow write: if hasPermission('manage:transactions');
      allow delete: if isAdmin();
    }
  }
}