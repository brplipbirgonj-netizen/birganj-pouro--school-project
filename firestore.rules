
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    
    function isAuthed() {
      return request.auth != null;
    }

    // isAdmin: checks the caller's role from their user document
    function isAdmin() {
      return isAuthed() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Check if the user has an existing profile in the system
    function hasAccount() {
      return isAuthed() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // --- Rules for Collections ---

    match /school/info {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{userId} {
      // Rule 1: A user can always read and update their OWN document
      allow get, update: if isAuthed() && request.auth.uid == userId;

      // Rule 2: Admin can read any user document
      allow list, get: if isAdmin();

      // Rule 3: Admin can create/update any user document
      allow create, update: if isAdmin();

      // Rule 4: Admin can DELETE any user document (explicit delete rule)
      allow delete: if isAdmin();

      // Rule 5: Allow profile creation during signup (own document only)
      allow create: if isAuthed() && request.auth.uid == userId;
    }

    match /classRoutines/{id} {
      allow read: if hasAccount();
      allow write: if isAdmin();
    }

    match /notices/{id} {
      allow read: if hasAccount();
      allow write: if isAdmin() || (hasAccount() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher');
    }

    match /holidays/{id} {
      allow read: if hasAccount();
      allow write: if isAdmin();
    }
    
    match /exams/{id} {
      allow read: if hasAccount();
      allow write: if isAdmin();
    }

    match /students/{id} {
      allow read: if hasAccount();
      allow write: if isAdmin();
    }
    
    match /staff/{id} {
      allow read: if isAuthed();
      allow write: if isAdmin();
    }

    match /attendance/{id} {
      allow read, write: if hasAccount();
    }
    
    match /results/{id} {
      allow read, write: if hasAccount();
    }

    match /messageLogs/{id} {
      allow read, write: if hasAccount();
      allow delete: if isAdmin();
    }

    match /emailLogs/{id} {
      allow read, write: if hasAccount();
    }

    match /feeCollections/{id} {
      allow read, write: if hasAccount();
    }

    match /transactions/{id} {
      allow read, write: if hasAccount();
    }
  }
}
