
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    
    function isAuthed() {
      return request.auth != null;
    }

    // Safely get user data
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Check if user document exists
    function userExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Direct check for admin role or permission
    function isAdmin() {
      return isAuthed() && userExists() && getUserData().role == 'admin';
    }

    // Direct check for specific permission (admins have all permissions)
    function hasPermission(permission) {
      return isAuthed() && userExists() && (
        getUserData().role == 'admin' || 
        permission in getUserData().get('permissions', [])
      );
    }

    // --- Rules for Collections ---

    match /school/info {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow get, update: if isAuthed() && request.auth.uid == userId;
      allow list: if isAdmin();
      allow create: if isAuthed();
      allow delete: if isAdmin();
    }

    match /classRoutines/{id} {
      allow read: if isAuthed();
      allow write: if hasPermission('manage:routines');
    }

    match /proxyClasses/{id} {
      allow read: if isAuthed();
      allow create, update, delete, write: if hasPermission('manage:routines');
    }

    match /notices/{id} {
      allow read: if isAuthed();
      allow write: if hasPermission('manage:documents');
      allow delete: if isAdmin();
    }

    match /holidays/{id} {
      allow read: if isAuthed();
      allow write: if hasPermission('manage:documents');
      allow delete: if isAdmin();
    }
    
    match /exams/{id} {
      allow read: if isAuthed();
      allow write: if isAdmin();
    }

    match /students/{id} {
      allow read: if isAuthed();
      allow write: if hasPermission('manage:students');
      allow delete: if isAdmin();
    }
    
    match /staff/{id} {
      allow read: if isAuthed();
      allow write: if hasPermission('manage:staff');
      allow delete: if isAdmin();
    }

    match /staffAttendance/{id} {
      allow read: if isAuthed();
      allow write: if hasPermission('manage:staff-attendance');
    }

    match /attendance/{id} {
      allow read: if isAuthed();
      allow write: if hasPermission('manage:attendance');
      allow delete: if isAdmin();
    }
    
    match /results/{id} {
      allow read: if isAuthed();
      allow write: if hasPermission('input:results') || hasPermission('manage:results');
      allow delete: if isAdmin();
    }

    match /messageLogs/{id} {
      allow read: if isAuthed();
      allow create: if hasPermission('send:messaging');
      allow update, delete: if hasPermission('manage:messaging');
    }

    match /feeCollections/{id} {
      allow read: if isAuthed();
      allow write: if hasPermission('collect:fees');
      allow delete: if isAdmin();
    }

    match /transactions/{id} {
      allow read: if isAuthed();
      allow write: if hasPermission('manage:transactions');
      allow delete: if isAdmin();
    }

    match /admissionApplications/{id} {
      // Public creation allowed for anyone
      allow create: if true;
      // Management permissions
      allow read, update, delete: if isAuthed() && hasPermission('manage:admissions');
    }
    
    // Trigger deployment: Refining helper functions and explicit permission hierarchy.
  }
}
