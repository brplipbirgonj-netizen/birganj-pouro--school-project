
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    
    function isAuthed() {
      return request.auth != null;
    }

    // Safely check for admin role (short-circuits if not authed)
    function isAdmin() {
      return isAuthed() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Safely check for specific permission (short-circuits if not authed)
    function hasPermission(permission) {
      return isAuthed() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' || 
        permission in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('permissions', [])
      );
    }

    // --- Rules for Collections ---

    // 1. Admission Applications (Must be public for create)
    match /admissionApplications/{id} {
      // Public creation allowed for anyone to apply online
      allow create: if true;
      // Reading/Managing is restricted to staff with permission
      allow read, write: if isAuthed() && hasPermission('manage:admissions');
    }

    // 2. School Info
    match /school/info {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 3. User Profiles
    match /users/{userId} {
      allow get, update: if isAuthed() && request.auth.uid == userId;
      allow list: if isAdmin();
      allow create: if isAuthed();
      allow delete: if isAdmin();
    }

    // 4. Academic & Management Collections
    match /classRoutines/{id} {
      allow read: if isAuthed();
      allow write: if hasPermission('manage:routines');
    }

    match /proxyClasses/{id} {
      allow read: if isAuthed();
      allow create, update, delete, write: if hasPermission('manage:routines');
    }

    match /notices/{id} {
      allow read: if isAuthed();
      allow write: if hasPermission('manage:documents');
      allow delete: if isAdmin();
    }

    match /holidays/{id} {
      allow read: if isAuthed();
      allow write: if hasPermission('manage:documents');
      allow delete: if isAdmin();
    }
    
    match /exams/{id} {
      allow read: if isAuthed();
      allow write: if isAdmin();
    }

    match /students/{id} {
      allow read: if isAuthed();
      allow write: if hasPermission('manage:students');
      allow delete: if isAdmin();
    }
    
    match /staff/{id} {
      allow read: if isAuthed();
      allow write: if hasPermission('manage:staff');
      allow delete: if isAdmin();
    }

    match /staffAttendance/{id} {
      allow read: if isAuthed();
      allow write: if hasPermission('manage:staff-attendance');
    }

    match /attendance/{id} {
      allow read: if isAuthed();
      allow write: if hasPermission('manage:attendance');
      allow delete: if isAdmin();
    }
    
    match /results/{id} {
      allow read: if isAuthed();
      allow write: if hasPermission('input:results') || hasPermission('manage:results');
      allow delete: if isAdmin();
    }

    match /messageLogs/{id} {
      allow read: if isAuthed();
      allow create: if hasPermission('send:messaging');
      allow update, delete: if hasPermission('manage:messaging');
    }

    match /feeCollections/{id} {
      allow read: if isAuthed();
      allow write: if hasPermission('collect:fees');
      allow delete: if isAdmin();
    }

    match /transactions/{id} {
      allow read: if isAuthed();
      allow write: if hasPermission('manage:transactions');
      allow delete: if isAdmin();
    }
    
    // Deployment Version: 2024-05-22T10:45:00Z - Critical Fix for Public Submission
  }
}
