
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    
    function isAuthed() {
      return request.auth != null;
    }

    // Direct check for admin role from the users collection
    function isAdmin() {
      return isAuthed() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Direct check for specific permission
    function hasPermission(permission) {
      return isAuthed() && 
        (permission in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.permissions);
    }

    // --- Rules for Collections ---

    match /school/info {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow get, update: if isAuthed() && request.auth.uid == userId;
      allow list: if isAdmin();
      allow create: if isAuthed(); // Allow initial profile creation
      allow delete: if isAdmin();
    }

    match /classRoutines/{id} {
      allow read: if isAuthed();
      allow write: if isAdmin() || hasPermission('manage:routines');
    }

    match /proxyClasses/{id} {
      allow read: if isAuthed();
      // Allow specific write operations for proxy assignments
      allow create, update, delete, write: if isAdmin() || hasPermission('manage:routines');
    }

    match /notices/{id} {
      allow read: if isAuthed();
      allow write: if isAdmin() || hasPermission('manage:documents');
      allow delete: if isAdmin();
    }

    match /holidays/{id} {
      allow read: if isAuthed();
      allow write: if isAdmin() || hasPermission('manage:documents');
      allow delete: if isAdmin();
    }
    
    match /exams/{id} {
      allow read: if isAuthed();
      allow write: if isAdmin();
    }

    match /students/{id} {
      allow read: if isAuthed();
      allow write: if isAdmin() || hasPermission('manage:students');
      allow delete: if isAdmin();
    }
    
    match /staff/{id} {
      allow read: if isAuthed();
      allow write: if isAdmin() || hasPermission('manage:staff');
      allow delete: if isAdmin();
    }

    match /staffAttendance/{id} {
      allow read: if isAuthed();
      allow write: if isAdmin() || hasPermission('manage:staff-attendance');
    }

    match /attendance/{id} {
      allow read: if isAuthed();
      allow write: if isAdmin() || hasPermission('manage:attendance');
      allow delete: if isAdmin();
    }
    
    match /results/{id} {
      allow read: if isAuthed();
      allow write: if isAdmin() || hasPermission('input:results') || hasPermission('manage:results');
      allow delete: if isAdmin();
    }

    match /messageLogs/{id} {
      allow read: if isAuthed();
      allow create: if isAdmin() || hasPermission('send:messaging');
      allow update, delete: if isAdmin() || hasPermission('manage:messaging');
    }

    match /feeCollections/{id} {
      allow read: if isAuthed();
      allow write: if isAdmin() || hasPermission('collect:fees');
      allow delete: if isAdmin();
    }

    match /transactions/{id} {
      allow read: if isAuthed();
      allow write: if isAdmin() || hasPermission('manage:transactions');
      allow delete: if isAdmin();
    }
  }
}
