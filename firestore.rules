
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthed() {
      return request.auth != null;
    }

    // Ensures user exists and checks their role directly
    function isAdmin() {
      return isAuthed() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    function isTeacher() {
      return isAuthed() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    function hasAccount() {
      return isAuthed() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Rules
    match /school/info {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{userId} {
      // Allow list for signup check and admin management
      allow list: if isAuthed(); 
      // User can read/update their own profile, admin can do anything
      allow get: if isAuthed() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthed() && request.auth.uid == userId;
      allow update: if isAuthed() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    match /classRoutines/{id} {
      allow read: if hasAccount();
      allow write: if isAdmin();
    }

    match /notices/{id} {
      allow read: if hasAccount();
      allow write: if isAdmin() || isTeacher();
    }

    match /holidays/{id} {
      allow read: if hasAccount();
      allow write: if isAdmin();
    }
    
    match /exams/{id} {
      allow read: if hasAccount();
      allow write: if isAdmin();
    }

    match /students/{id} {
      allow read: if hasAccount();
      allow write: if isAdmin();
    }
    
    match /staff/{id} {
      // Allow authed users to check their email against staff list during signup/login
      allow read: if isAuthed();
      allow write: if isAdmin();
    }

    match /attendance/{id} {
      allow read: if hasAccount();
      allow write: if hasAccount();
    }
    
    match /results/{id} {
      allow read: if hasAccount();
      allow write: if hasAccount();
    }

    match /messageLogs/{id} {
      allow read: if hasAccount();
      allow write: if hasAccount();
      allow delete: if isAdmin();
    }

    match /emailLogs/{id} {
      allow read, write: if hasAccount();
    }

    match /feeCollections/{id} {
      allow read: if hasAccount();
      allow write: if hasAccount();
    }

    match /transactions/{id} {
      allow read: if hasAccount();
      allow write: if hasAccount();
    }
  }
}
