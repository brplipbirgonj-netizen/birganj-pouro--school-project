
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    
    function isAuthed() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthed() && getUserData().role == 'admin';
    }

    function hasAccount() {
      return isAuthed() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    
    function hasPermission(permission) {
      return isAuthed() && hasAccount() && (permission in getUserData().permissions);
    }

    // --- Rules for Collections ---

    match /school/info {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow get, update: if isAuthed() && request.auth.uid == userId;
      allow list, get: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
      allow create: if isAuthed() && request.auth.uid == userId;
    }

    match /classRoutines/{id} {
      allow read: if hasAccount();
      allow create, update: if isAdmin() || hasPermission('manage:routines');
      allow delete: if isAdmin();
    }

    match /notices/{id} {
      allow read: if hasAccount();
      allow create, update: if isAdmin() || hasPermission('manage:documents');
      allow delete: if isAdmin();
    }

    match /holidays/{id} {
      allow read: if hasAccount();
      allow create, update: if isAdmin() || hasPermission('manage:documents');
      allow delete: if isAdmin();
    }
    
    match /exams/{id} {
      allow read: if hasAccount();
      allow write: if isAdmin();
    }

    match /students/{id} {
      allow read: if hasAccount();
      allow create, update: if isAdmin() || hasPermission('manage:students');
      allow delete: if isAdmin();
    }
    
    match /staff/{id} {
      allow read: if isAuthed();
      allow create, update: if isAdmin() || hasPermission('manage:staff');
      allow delete: if isAdmin();
    }

    match /attendance/{id} {
      allow read: if hasAccount();
      allow create, update: if isAdmin() || hasPermission('manage:attendance');
      allow delete: if isAdmin();
    }
    
    match /results/{id} {
      allow read: if hasAccount();
      allow create, update: if isAdmin() || hasPermission('input:results') || hasPermission('manage:results');
      allow delete: if isAdmin();
    }

    match /messageLogs/{id} {
      allow read: if hasAccount();
      allow create, update: if isAdmin() || hasPermission('manage:messaging');
      allow delete: if isAdmin();
    }

    match /emailLogs/{id} {
      allow read: if hasAccount();
      allow create, update: if isAdmin() || hasPermission('manage:messaging');
      allow delete: if isAdmin();
    }

    match /feeCollections/{id} {
      allow read: if hasAccount();
      allow create, update: if isAdmin() || hasPermission('collect:fees');
      allow delete: if isAdmin();
    }

    match /transactions/{id} {
      allow read: if hasAccount();
      allow create, update: if isAdmin() || hasPermission('manage:transactions');
      allow delete: if isAdmin();
    }
  }
}
