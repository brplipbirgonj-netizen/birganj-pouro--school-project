
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    
    function isAuthed() {
      return request.auth != null;
    }

    // Directly get the user's role without complex logic to avoid recursion
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthed() && getUserData().role == 'admin';
    }
    
    function isTeacher() {
      return isAuthed() && getUserData().role == 'teacher';
    }

    function hasAccount() {
      return isAuthed() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // --- Rules for Collections ---

    match /school/info {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{userId} {
      // CRITICAL: Allow any authenticated user to read their OWN document.
      // This breaks the circular dependency when isAdmin() calls get().
      allow get: if isAuthed() && request.auth.uid == userId;
      
      // Allow user to create their own profile during signup
      allow create: if isAuthed() && request.auth.uid == userId;

      // Admin can do everything with user documents
      allow list: if isAdmin();
      allow get: if isAdmin();
      allow delete: if isAdmin();
      
      // Both the user themselves and the admin can update profile (except role for non-admins)
      allow update: if isAuthed() && (request.auth.uid == userId || isAdmin());
    }

    match /classRoutines/{id} {
      allow read: if hasAccount();
      allow write: if isAdmin();
    }

    match /notices/{id} {
      allow read: if hasAccount();
      allow write: if isAdmin() || isTeacher();
    }

    match /holidays/{id} {
      allow read: if hasAccount();
      allow write: if isAdmin();
    }
    
    match /exams/{id} {
      allow read: if hasAccount();
      allow write: if isAdmin();
    }

    match /students/{id} {
      allow read: if hasAccount();
      allow write: if isAdmin();
    }
    
    match /staff/{id} {
      // Allow authed users to check their email against staff list during signup/login
      allow read: if isAuthed();
      allow write: if isAdmin();
    }

    match /attendance/{id} {
      allow read: if hasAccount();
      allow write: if hasAccount();
    }
    
    match /results/{id} {
      allow read: if hasAccount();
      allow write: if hasAccount();
    }

    match /messageLogs/{id} {
      allow read: if hasAccount();
      allow write: if hasAccount();
      allow delete: if isAdmin();
    }

    match /emailLogs/{id} {
      allow read, write: if hasAccount();
    }

    match /feeCollections/{id} {
      allow read: if hasAccount();
      allow write: if hasAccount();
    }

    match /transactions/{id} {
      allow read: if hasAccount();
      allow write: if hasAccount();
    }
  }
}
