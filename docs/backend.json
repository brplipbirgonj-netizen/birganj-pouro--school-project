
{
  "entities": {
    "user": {
      "title": "User",
      "description": "Represents an application user with a role and online status.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["admin", "teacher"] },
        "photoUrl": { "type": "string" },
        "displayName": { "type": "string" },
        "isOnline": { "type": "boolean" },
        "permissions": { "type": "array", "items": { "type": "string" } },
        "lastLoginAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "student": {
      "title": "Student",
      "description": "A student in the school",
      "type": "object",
      "properties": {
        "generatedId": { "type": "string" },
        "roll": { "type": "number" },
        "className": { "type": "string" },
        "academicYear": { "type": "string" },
        "studentNameBn": { "type": "string" },
        "studentNameEn": { "type": "string" },
        "photoUrl": { "type": "string" }
      },
      "required": ["roll", "className", "academicYear", "studentNameBn", "photoUrl"]
    },
    "admissionApplication": {
      "title": "Admission Application",
      "description": "An online application for student admission submitted by parents.",
      "type": "object",
      "properties": {
        "applicationId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "appliedAt": { "type": "string", "format": "date-time" },
        "className": { "type": "string" },
        "academicYear": { "type": "string" },
        "studentNameBn": { "type": "string" },
        "guardianMobile": { "type": "string" },
        "photoUrl": { "type": "string" }
      },
      "required": ["studentNameBn", "className", "academicYear", "guardianMobile", "photoUrl"]
    }
  },
  "auth": {
    "providers": ["emailPassword"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/user" },
      "description": "Stores user profile information."
    },
    "/students/{studentId}": {
      "schema": { "$ref": "#/entities/student" },
      "description": "Stores individual student records."
    },
    "/admissionApplications/{id}": {
      "schema": { "$ref": "#/entities/admissionApplication" },
      "description": "Stores online admission applications."
    }
  }
}
